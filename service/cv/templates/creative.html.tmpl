<!DOCTYPE html>
<html lang="{{.Locale}}">
<head>
<meta charset="UTF-8" />
<title>{{.Personal.Name}}</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Inter', sans-serif; color: #1a1a1a; line-height: 1.5; max-width: 800px; margin: 0 auto; font-size: 11pt; }
  .layout { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
  aside { background: #E35323; color: white; padding: 40px 24px; }
  main { padding: 40px 32px; }
  h1 { font-size: 22pt; font-weight: 800; color: white; line-height: 1.1; }
  .role { font-size: 11pt; color: rgba(255,255,255,0.85); margin-top: 8px; }
  aside h2 { font-size: 10pt; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: rgba(255,255,255,0.7); margin-top: 24px; margin-bottom: 8px; }
  aside .item { font-size: 9.5pt; color: white; margin-bottom: 6px; }
  aside .tag { display: inline-block; background: rgba(255,255,255,0.15); color: white; padding: 3px 8px; border-radius: 12px; font-size: 9pt; margin-right: 4px; margin-bottom: 4px; }
  main h2 { font-size: 11pt; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: #E35323; margin-top: 20px; margin-bottom: 10px; }
  main h2:first-child { margin-top: 0; }
  .item { margin-bottom: 14px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; }
  .title { font-weight: 700; font-size: 11pt; }
  .meta { color: #888; font-size: 9.5pt; }
  .sub { color: #555; font-size: 10pt; margin-top: 2px; }
  ul { margin-top: 4px; padding-left: 16px; }
  li { margin-bottom: 3px; }
</style>
</head>
<body>
<div class="layout">
  <aside>
    <h1>{{.Personal.Name}}</h1>
    {{if nonzero .Personal.Title}}<div class="role">{{.Personal.Title}}</div>{{end}}

    <h2>Contact</h2>
    {{if nonzero .Personal.Email}}<div class="item">{{.Personal.Email}}</div>{{end}}
    {{if nonzero .Personal.Phone}}<div class="item">{{.Personal.Phone}}</div>{{end}}
    {{if nonzero .Personal.Location}}<div class="item">{{.Personal.Location}}</div>{{end}}
    {{if nonzero .Personal.LinkedIn}}<div class="item">{{.Personal.LinkedIn}}</div>{{end}}
    {{if nonzero .Personal.GitHub}}<div class="item">{{.Personal.GitHub}}</div>{{end}}

    {{if .HasContent.skills}}
    <h2>Skills</h2>
    <div>{{range .Skills.Technical}}<span class="tag">{{.}}</span>{{end}}</div>
    {{end}}

    {{if .HasContent.languages}}
    <h2>Languages</h2>
    {{range .Languages}}<div class="item">{{.Name}}{{if nonzero .Level}} <span style="opacity:0.7;">— {{.Level}}</span>{{end}}</div>{{end}}
    {{end}}
  </aside>
  <main>
    {{if .HasContent.summary}}<section><h2>Profile</h2><p>{{.Summary}}</p></section>{{end}}
    {{if .HasContent.experience}}<section><h2>Experience</h2>{{range .Experience}}<div class="item"><div class="row"><div class="title">{{.Title}}</div><div class="meta">{{.Period}}</div></div><div class="sub">{{.Company}}{{if nonzero .Location}} · {{.Location}}{{end}}</div>{{if .Bullets}}<ul>{{range .Bullets}}<li>{{.}}</li>{{end}}</ul>{{end}}</div>{{end}}</section>{{end}}
    {{if .HasContent.education}}<section><h2>Education</h2>{{range .Education}}<div class="item"><div class="row"><div class="title">{{.Degree}}</div><div class="meta">{{.Period}}</div></div><div class="sub">{{.School}}</div></div>{{end}}</section>{{end}}
    {{if .HasContent.projects}}<section><h2>Projects</h2>{{range .Projects}}<div class="item"><div class="title">{{.Name}}</div>{{if nonzero .Description}}<div class="sub">{{.Description}}</div>{{end}}</div>{{end}}</section>{{end}}
    {{if .HasContent.awards}}<section><h2>Awards</h2>{{range .Awards}}<div class="item"><div class="row"><div class="title">{{.Title}}</div><div class="meta">{{.Year}}</div></div></div>{{end}}</section>{{end}}
  </main>
</div>
</body>
</html>
