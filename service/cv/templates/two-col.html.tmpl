<!DOCTYPE html>
<html lang="{{.Locale}}">
<head>
<meta charset="UTF-8" />
<title>{{.Personal.Name}} — Resume</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Inter', -apple-system, system-ui, 'Segoe UI', sans-serif;
    color: #1F2937;
    line-height: 1.5;
    font-size: 10.5pt;
    max-width: 820px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: 100vh;
  }
  aside {
    background: #1F2937;
    color: #E5E7EB;
    padding: 36px 24px;
  }
  aside h1 { font-size: 22pt; font-weight: 800; line-height: 1.1; color: #fff; letter-spacing: -0.5px; }
  aside .role { font-size: 11pt; color: #93C5FD; margin-top: 6px; font-weight: 500; }
  aside .divider { height: 1px; background: #374151; margin: 22px 0 14px; }
  aside h2 {
    font-size: 9.5pt; font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; color: #60A5FA;
    margin-top: 18px; margin-bottom: 8px;
  }
  aside .contact-line {
    font-size: 9.5pt; color: #D1D5DB;
    margin-bottom: 5px; word-break: break-word;
  }
  aside .tags { display: flex; flex-wrap: wrap; gap: 4px; }
  aside .tag {
    background: #374151; color: #E5E7EB; padding: 2px 8px;
    border-radius: 4px; font-size: 9pt; font-weight: 500;
  }
  aside .sk-list { font-size: 9.5pt; }
  aside .sk-list .sk-row { padding: 2px 0; color: #E5E7EB; }
  main { padding: 36px 32px; background: #fff; }
  main h2 {
    font-size: 11pt; font-weight: 800; letter-spacing: 1.5px;
    text-transform: uppercase; color: #1F2937;
    border-bottom: 2px solid #3B82F6; padding-bottom: 4px;
    margin-top: 18px; margin-bottom: 12px;
  }
  main h2:first-child { margin-top: 0; }
  .item { margin-bottom: 14px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; }
  .title { font-weight: 700; font-size: 11pt; color: #111827; }
  .meta { color: #6B7280; font-size: 9.5pt; font-weight: 500; }
  .sub { color: #4B5563; font-size: 10pt; margin-top: 1px; font-weight: 500; }
  ul { margin-top: 5px; padding-left: 16px; }
  li { margin-bottom: 3px; }
  p { font-size: 10.5pt; }
</style>
</head>
<body>
<aside>
  <h1>{{.Personal.Name}}</h1>
  {{if nonzero .Personal.Title}}<div class="role">{{.Personal.Title}}</div>{{end}}

  <div class="divider"></div>

  <h2>Contact</h2>
  {{if nonzero .Personal.Email}}<div class="contact-line">✉ {{.Personal.Email}}</div>{{end}}
  {{if nonzero .Personal.Phone}}<div class="contact-line">☎ {{.Personal.Phone}}</div>{{end}}
  {{if nonzero .Personal.Location}}<div class="contact-line">📍 {{.Personal.Location}}</div>{{end}}
  {{if nonzero .Personal.LinkedIn}}<div class="contact-line">in {{.Personal.LinkedIn}}</div>{{end}}
  {{if nonzero .Personal.GitHub}}<div class="contact-line">⌥ {{.Personal.GitHub}}</div>{{end}}
  {{if nonzero .Personal.Website}}<div class="contact-line">🌐 {{.Personal.Website}}</div>{{end}}

  {{if .HasContent.skills}}
  <h2>Skills</h2>
  <div class="tags">
    {{range .Skills.Technical}}<span class="tag">{{.}}</span>{{end}}
  </div>
  {{if .Skills.Soft}}
  <h2 style="margin-top:14px;">Soft Skills</h2>
  <div class="sk-list">{{range .Skills.Soft}}<div class="sk-row">• {{.}}</div>{{end}}</div>
  {{end}}
  {{end}}

  {{if .HasContent.languages}}
  <h2>Languages</h2>
  <div class="sk-list">
    {{range .Languages}}<div class="sk-row">{{.Name}}{{if nonzero .Level}} <span style="color:#93C5FD;">— {{.Level}}</span>{{end}}</div>{{end}}
  </div>
  {{end}}

  {{if .HasContent.certifications}}
  <h2>Certifications</h2>
  <div class="sk-list">
    {{range .Certs}}<div class="sk-row">{{.Name}}{{if nonzero .Year}} ({{.Year}}){{end}}</div>{{end}}
  </div>
  {{end}}
</aside>

<main>
  {{if .HasContent.summary}}<h2>Profile</h2><p>{{.Summary}}</p>{{end}}

  {{if .HasContent.experience}}<h2>Experience</h2>
  {{range .Experience}}<div class="item">
    <div class="row"><div class="title">{{.Title}}</div><div class="meta">{{.Period}}</div></div>
    <div class="sub">{{.Company}}{{if nonzero .Location}} · {{.Location}}{{end}}</div>
    {{if .Bullets}}<ul>{{range .Bullets}}<li>{{.}}</li>{{end}}</ul>{{end}}
  </div>{{end}}
  {{end}}

  {{if .HasContent.education}}<h2>Education</h2>
  {{range .Education}}<div class="item">
    <div class="row"><div class="title">{{.Degree}}</div><div class="meta">{{.Period}}</div></div>
    <div class="sub">{{.School}}{{if nonzero .GPA}} · GPA {{.GPA}}{{end}}{{if nonzero .Honors}} · {{.Honors}}{{end}}</div>
  </div>{{end}}
  {{end}}

  {{if .HasContent.projects}}<h2>Projects</h2>
  {{range .Projects}}<div class="item">
    <div class="title">{{.Name}}{{if nonzero .Link}} <span class="meta">· {{.Link}}</span>{{end}}</div>
    {{if nonzero .Description}}<div class="sub">{{.Description}}</div>{{end}}
  </div>{{end}}
  {{end}}

  {{if .HasContent.awards}}<h2>Awards</h2>
  {{range .Awards}}<div class="item">
    <div class="row"><div class="title">{{.Title}}</div><div class="meta">{{.Year}}</div></div>
    {{if nonzero .Issuer}}<div class="sub">{{.Issuer}}</div>{{end}}
  </div>{{end}}
  {{end}}
</main>
</body>
</html>
