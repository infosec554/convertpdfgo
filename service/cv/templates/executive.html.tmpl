<!DOCTYPE html>
<html lang="{{.Locale}}">
<head>
<meta charset="UTF-8" />
<title>{{.Personal.Name}} — Resume</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Garamond', 'EB Garamond', Georgia, 'Times New Roman', serif;
    color: #1B1B1B;
    line-height: 1.55;
    padding: 56px 64px;
    max-width: 820px;
    margin: 0 auto;
    font-size: 11pt;
  }
  header { text-align: center; padding-bottom: 18px; margin-bottom: 22px; border-bottom: 1px solid #BCA77A; }
  h1 { font-size: 30pt; font-weight: 600; letter-spacing: 4px; text-transform: uppercase; }
  .role { font-size: 11pt; color: #5A5A5A; margin-top: 6px; letter-spacing: 3px; text-transform: uppercase; }
  .contact { margin-top: 14px; font-size: 10pt; color: #4A4A4A; }
  .contact span:not(:last-child)::after { content: " · "; color: #BCA77A; margin: 0 8px; }
  h2 {
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    text-align: center;
    color: #1B1B1B;
    margin-top: 22px;
    margin-bottom: 14px;
    position: relative;
  }
  h2::before, h2::after {
    content: ""; display: inline-block; width: 36px; height: 1px;
    background: #BCA77A; vertical-align: middle; margin: 0 12px;
  }
  .item { margin-bottom: 14px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; }
  .title { font-weight: 700; font-size: 11.5pt; }
  .meta { font-style: italic; color: #5A5A5A; font-size: 10.5pt; }
  .sub { color: #3A3A3A; font-size: 11pt; margin-top: 1px; font-style: italic; }
  ul { margin-top: 6px; padding-left: 18px; }
  li { margin-bottom: 3px; }
  .skills-list { columns: 2; column-gap: 32px; font-size: 10.5pt; }
  .skills-list .row-skill { padding: 2px 0; }
  p { text-align: justify; }
</style>
</head>
<body>
<header>
  <h1>{{.Personal.Name}}</h1>
  {{if nonzero .Personal.Title}}<div class="role">{{.Personal.Title}}</div>{{end}}
  <div class="contact">
    {{if nonzero .Personal.Email}}<span>{{.Personal.Email}}</span>{{end}}
    {{if nonzero .Personal.Phone}}<span>{{.Personal.Phone}}</span>{{end}}
    {{if nonzero .Personal.Location}}<span>{{.Personal.Location}}</span>{{end}}
    {{if nonzero .Personal.LinkedIn}}<span>{{.Personal.LinkedIn}}</span>{{end}}
  </div>
</header>

{{if .HasContent.summary}}<section><h2>Executive Profile</h2><p>{{.Summary}}</p></section>{{end}}

{{if .HasContent.experience}}<section><h2>Professional Experience</h2>
{{range .Experience}}<div class="item">
  <div class="row"><div class="title">{{.Company}}{{if nonzero .Location}} — {{.Location}}{{end}}</div><div class="meta">{{.Period}}</div></div>
  <div class="sub">{{.Title}}</div>
  {{if .Bullets}}<ul>{{range .Bullets}}<li>{{.}}</li>{{end}}</ul>{{end}}
</div>{{end}}
</section>{{end}}

{{if .HasContent.education}}<section><h2>Education</h2>
{{range .Education}}<div class="item">
  <div class="row"><div class="title">{{.School}}</div><div class="meta">{{.Period}}</div></div>
  <div class="sub">{{.Degree}}{{if nonzero .Honors}} — {{.Honors}}{{end}}{{if nonzero .GPA}} (GPA: {{.GPA}}){{end}}</div>
</div>{{end}}
</section>{{end}}

{{if .HasContent.skills}}<section><h2>Core Competencies</h2>
<div class="skills-list">
  {{range .Skills.Technical}}<div class="row-skill">— {{.}}</div>{{end}}
  {{range .Skills.Soft}}<div class="row-skill">— {{.}}</div>{{end}}
</div>
</section>{{end}}

{{if .HasContent.awards}}<section><h2>Honors & Awards</h2>
{{range .Awards}}<div class="item">
  <div class="row"><div class="title">{{.Title}}</div><div class="meta">{{.Year}}</div></div>
  {{if nonzero .Issuer}}<div class="sub">{{.Issuer}}</div>{{end}}
</div>{{end}}
</section>{{end}}

{{if .HasContent.languages}}<section><h2>Languages</h2>
<p style="text-align:center;">{{range $i, $l := .Languages}}{{if $i}} · {{end}}{{$l.Name}}{{if nonzero $l.Level}} ({{$l.Level}}){{end}}{{end}}</p>
</section>{{end}}

</body>
</html>
