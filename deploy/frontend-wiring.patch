@@ -0,0 +1,100 @@
+"use client";
+
+import { useState } from "react";
+import { Eye, EyeOff } from "lucide-react";
+import { SimpleToolClient } from "@/components/tools/simple-tool-client";
+
+/**
+ * Add a password to a PDF. Body shape: { input_file_id, password }.
+ * Repeats the password locally so the user doesn't lock themselves
+ * out of their own file with a typo we never see.
+ */
+export function ProtectClient() {
+  const [password, setPassword] = useState("");
+  const [confirm, setConfirm] = useState("");
+  const [show, setShow] = useState(false);
+
+  const mismatch = password.length > 0 && confirm.length > 0 && password !== confirm;
+  const tooShort = password.length > 0 && password.length < 6;
+
+  return (
+    <SimpleToolClient
+      op="protect"
+      cta="Protect now →"
+      resultFilename={(f) => `protected-${f?.name ?? "result.pdf"}`}
+      downloadLabel="Download protected PDF"
+      buildExtraBody={() => ({ password })}
+      extraFields={
+        <div className="grid gap-4">
+          <PasswordRow
+            id="protect-pwd"
+            label="Password"
+            value={password}
+            show={show}
+            onChange={setPassword}
+            onToggle={() => setShow((v) => !v)}
+            invalid={tooShort}
+            invalidMsg="At least 6 characters"
+          />
+          <PasswordRow
+            id="protect-pwd-confirm"
+            label="Confirm password"
+            value={confirm}
+            show={show}
+            onChange={setConfirm}
+            onToggle={() => setShow((v) => !v)}
+            invalid={mismatch}
+            invalidMsg="Passwords don't match"
+          />
+        </div>
+      }
+    />
+  );
+}
+
+function PasswordRow({
+  id,
+  label,
+  value,
+  show,
+  onChange,
+  onToggle,
+  invalid,
+  invalidMsg,
+}: {
+  id: string;
+  label: string;
+  value: string;
+  show: boolean;
+  onChange: (v: string) => void;
+  onToggle: () => void;
+  invalid: boolean;
+  invalidMsg: string;
+}) {
+  return (
+    <label htmlFor={id} className="grid gap-1.5">
+      <span className="text-sm font-medium">{label}</span>
+      <div className="relative">
+        <input
+          id={id}
+          type={show ? "text" : "password"}
+          value={value}
+          onChange={(e) => onChange(e.target.value)}
+          className={`w-full rounded-lg border bg-card px-3 py-2 pr-10 text-sm focus:outline-none ${
+            invalid ? "border-destructive focus:border-destructive" : "focus:border-primary"
+          }`}
+          autoComplete="new-password"
+        />
+        <button
+          type="button"
+          onClick={onToggle}
+          aria-label={show ? "Hide password" : "Show password"}
+          className="absolute right-2 top-1/2 -translate-y-1/2 rounded p-1 text-muted-foreground hover:bg-accent"
+        >
+          {show ? <EyeOff className="size-4" /> : <Eye className="size-4" />}
+        </button>
+      </div>
+      {invalid && <span className="text-xs text-destructive">{invalidMsg}</span>}
+    </label>
+  );
+}
