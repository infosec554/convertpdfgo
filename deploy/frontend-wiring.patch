+"use client";
+
+import { useState } from "react";
+import { Button } from "@converto/ui/components/button";
+import { Card } from "@converto/ui/components/card";
+import { FileDropzone } from "@/components/tools/file-dropzone";
+import { JobStatusPanel } from "@/components/tools/job-status";
+import { useJobRunner } from "@/components/tools/use-job-runner";
+
+/**
+ * Multi-file merge. Backend accepts 2-50 PDFs and returns a single merged
+ * output_file_id. Reordering is left to the dropzone for now (drop in
+ * the order you want them concatenated) — a drag-handle list can replace
+ * the inline file list later without touching this client logic.
+ */
+export function MergeClient() {
+  const [files, setFiles] = useState<File[]>([]);
+  const runner = useJobRunner();
+
+  async function onSubmit() {
+    if (files.length < 2) return;
+    await runner.run(files, (ids) => ({ input_file_ids: ids }), "merge");
+  }
+
+  const totalMb = (files.reduce((s, f) => s + f.size, 0) / 1024 / 1024).toFixed(1);
+
+  return (
+    <Card className="grid gap-8 p-8">
+      <FileDropzone files={files} onChange={setFiles} multiple maxSizeMB={30} />
+
+      <div className="flex flex-col items-start justify-between gap-4 rounded-2xl bg-foreground p-5 text-background md:flex-row md:items-center">
+        <div className="flex flex-wrap gap-x-6 gap-y-1 font-mono text-xs uppercase tracking-wider">
+          <span>
+            <span className="text-primary">{files.length}</span> files
+          </span>
+          <span>
+            <span className="text-primary">{totalMb}</span> MB total
+          </span>
+          <span className="text-background/60">
+            {files.length < 2
+              ? "Pick at least 2 PDFs"
+              : files.length > 50
+              ? "Max 50 PDFs"
+              : "Order matches drop order"}
+          </span>
+        </div>
+        <Button
+          size="lg"
+          disabled={
+            files.length < 2 ||
+            files.length > 50 ||
+            runner.phase === "uploading" ||
+            runner.phase === "running"
+          }
+          onClick={onSubmit}
+        >
+          Merge now →
+        </Button>
+      </div>
+
+      <JobStatusPanel
+        phase={runner.phase}
+        error={runner.error}
+        onDownload={() => runner.download("merged.pdf")}
+        onReset={runner.reset}
+        downloadLabel="Download merged PDF"
+      />
+    </Card>
+  );
+}
