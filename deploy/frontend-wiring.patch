+"use client";
+
+import { useState } from "react";
+import { SimpleToolClient } from "@/components/tools/simple-tool-client";
+
+const positions = [
+  { code: "c", label: "Center" },
+  { code: "tl", label: "Top-left" },
+  { code: "tr", label: "Top-right" },
+  { code: "bl", label: "Bottom-left" },
+  { code: "br", label: "Bottom-right" },
+];
+
+/**
+ * Text watermark. Image-mode is a follow-up — wiring image_file_id
+ * requires a second upload field and a small UI toggle, which we'll
+ * fold in once the text variant has live traffic.
+ */
+export function WatermarkClient() {
+  const [text, setText] = useState("DRAFT");
+  const [position, setPosition] = useState("c");
+  const [opacity, setOpacity] = useState(0.4);
+  const [rotation, setRotation] = useState(-45);
+
+  return (
+    <SimpleToolClient
+      op="watermark"
+      cta="Add watermark →"
+      resultFilename={(f) => `watermarked-${f?.name ?? "result.pdf"}`}
+      downloadLabel="Download watermarked PDF"
+      buildExtraBody={() => ({
+        mode: "text",
+        text,
+        position,
+        opacity,
+        rotation,
+        pages: "all",
+      })}
+      extraFields={
+        <div className="grid gap-4 md:grid-cols-2">
+          <label className="grid gap-1.5">
+            <span className="text-sm font-medium">Text</span>
+            <input
+              type="text"
+              value={text}
+              onChange={(e) => setText(e.target.value)}
+              className="w-full rounded-lg border bg-card px-3 py-2 text-sm focus:border-primary focus:outline-none"
+            />
+          </label>
+          <label className="grid gap-1.5">
+            <span className="text-sm font-medium">Position</span>
+            <select
+              value={position}
+              onChange={(e) => setPosition(e.target.value)}
+              className="w-full rounded-lg border bg-card px-3 py-2 text-sm focus:border-primary focus:outline-none"
+            >
+              {positions.map((p) => (
+                <option key={p.code} value={p.code}>
+                  {p.label}
+                </option>
+              ))}
+            </select>
+          </label>
+          <label className="grid gap-1.5">
+            <span className="text-sm font-medium">
+              Opacity: <span className="text-muted-foreground">{opacity.toFixed(2)}</span>
+            </span>
+            <input
+              type="range"
+              min={0}
+              max={1}
+              step={0.05}
+              value={opacity}
+              onChange={(e) => setOpacity(parseFloat(e.target.value))}
+              className="w-full accent-primary"
+            />
+          </label>
+          <label className="grid gap-1.5">
+            <span className="text-sm font-medium">
+              Rotation: <span className="text-muted-foreground">{rotation}°</span>
+            </span>
+            <input
+              type="range"
+              min={-90}
+              max={90}
+              step={5}
+              value={rotation}
+              onChange={(e) => setRotation(parseInt(e.target.value, 10))}
+              className="w-full accent-primary"
+            />
+          </label>
+        </div>
+      }
+    />
+  );
+}
