@@ -0,0 +1,60 @@
+"use client";
+
+import { useState } from "react";
+import { SimpleToolClient } from "@/components/tools/simple-tool-client";
+
+const langs = [
+  { code: "eng", label: "English" },
+  { code: "rus", label: "Russian" },
+  { code: "uzb", label: "Uzbek (Latin)" },
+  { code: "uzb_cyrl", label: "Uzbek (Cyrillic)" },
+  { code: "kir", label: "Kyrgyz" },
+  { code: "eng+rus", label: "English + Russian" },
+  { code: "eng+uzb", label: "English + Uzbek" },
+];
+
+/**
+ * Add a searchable text layer to a scanned PDF. The lang code maps
+ * straight to Tesseract — multi-language hits use the `eng+uzb` syntax.
+ */
+export function OcrClient() {
+  const [lang, setLang] = useState("eng");
+  const [forceOcr, setForceOcr] = useState(false);
+
+  return (
+    <SimpleToolClient
+      op="ocr"
+      cta="Run OCR →"
+      resultFilename={(f) => `ocr-${f?.name ?? "result.pdf"}`}
+      downloadLabel="Download searchable PDF"
+      buildExtraBody={() => ({ lang, force_ocr: forceOcr })}
+      extraFields={
+        <div className="grid gap-4 sm:grid-cols-[1fr_auto]">
+          <label className="grid gap-1.5">
+            <span className="text-sm font-medium">Language</span>
+            <select
+              value={lang}
+              onChange={(e) => setLang(e.target.value)}
+              className="w-full rounded-lg border bg-card px-3 py-2 text-sm focus:border-primary focus:outline-none"
+            >
+              {langs.map((l) => (
+                <option key={l.code} value={l.code}>
+                  {l.label}
+                </option>
+              ))}
+            </select>
+          </label>
+          <label className="flex items-end gap-2 pb-2 text-sm">
+            <input
+              type="checkbox"
+              checked={forceOcr}
+              onChange={(e) => setForceOcr(e.target.checked)}
+              className="size-4 accent-primary"
+            />
+            <span>Re-OCR pages that already have text</span>
+          </label>
+        </div>
+      }
+    />
+  );
+}
