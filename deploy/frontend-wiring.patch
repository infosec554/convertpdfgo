+"use client";
+
+import { useState } from "react";
+import { ArrowRight } from "lucide-react";
+import { Button } from "@converto/ui/components/button";
+import { Card } from "@converto/ui/components/card";
+import { FileDropzone } from "@/components/tools/file-dropzone";
+import { JobStatusPanel } from "@/components/tools/job-status";
+import { useJobRunner } from "@/components/tools/use-job-runner";
+
+const presets = [
+  { key: "low", name: "Light", desc: "~30% smaller" },
+  { key: "medium", name: "Recommended", desc: "~75% smaller" },
+  { key: "high", name: "Extreme", desc: "~92% smaller" },
+] as const;
+
+type Preset = (typeof presets)[number]["key"];
+
+/**
+ * Client-side runner for /api/pdf/compress. Lives next to the static
+ * marketing card in page.tsx so the design stays untouched — this widget
+ * sits below it once the page lands.
+ */
+export function CompressClient() {
+  const [files, setFiles] = useState<File[]>([]);
+  const [preset, setPreset] = useState<Preset>("medium");
+  const runner = useJobRunner();
+  const file = files[0];
+
+  async function onSubmit() {
+    if (!file) return;
+    await runner.run(files, (ids) => ({ input_file_id: ids[0], compression: preset }), "compress");
+  }
+
+  return (
+    <Card className="grid gap-8 p-8">
+      <FileDropzone files={files} onChange={setFiles} maxSizeMB={30} />
+
+      <div className="grid gap-4 sm:grid-cols-3">
+        {presets.map((p) => (
+          <button
+            key={p.key}
+            type="button"
+            onClick={() => setPreset(p.key)}
+            className={`flex flex-col items-start gap-1 rounded-xl border p-4 text-left transition-colors ${
+              preset === p.key
+                ? "border-primary bg-primary/5"
+                : "border-border bg-card hover:border-primary/40"
+            }`}
+          >
+            <span className="text-sm font-semibold">{p.name}</span>
+            <span className="text-xs text-muted-foreground">{p.desc}</span>
+          </button>
+        ))}
+      </div>
+
+      <div className="flex items-center justify-between rounded-2xl bg-foreground p-5 text-background">
+        <div className="font-mono text-xs uppercase tracking-wider">
+          {file ? (
+            <>
+              <span className="text-primary">{file.name}</span>{" "}
+              · {(file.size / 1024 / 1024).toFixed(1)} MB
+            </>
+          ) : (
+            <>Pick a PDF to begin</>
+          )}
+        </div>
+        <Button size="lg" disabled={!file || runner.phase === "uploading" || runner.phase === "running"} onClick={onSubmit}>
+          Compress now <ArrowRight className="ml-1.5 size-4" />
+        </Button>
+      </div>
+
+      <JobStatusPanel
+        phase={runner.phase}
+        error={runner.error}
+        onDownload={() => runner.download(`compressed-${file?.name ?? "result.pdf"}`)}
+        onReset={runner.reset}
+        downloadLabel="Download compressed PDF"
+      />
+    </Card>
+  );
+}
