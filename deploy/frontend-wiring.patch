+          <div className="flex-1">
+            <p className="font-medium text-destructive">Watermark failed</p>
+            <p className="text-muted-foreground">{runner.error}</p>
+          </div>
+          <Button variant="outline" size="sm" onClick={runner.reset}>
+            Try again
+          </Button>
+        </div>
+      )}
+    </Card>
+  );
+}
