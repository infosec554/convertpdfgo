+++ b/apps/web/app/(tools)/split/split-client.tsx
@@ -0,0 +1,96 @@
+"use client";
+
+import { useState } from "react";
+import { Download } from "lucide-react";
+import { Button } from "@converto/ui/components/button";
+import { Card } from "@converto/ui/components/card";
+import { FileDropzone } from "@/components/tools/file-dropzone";
+import { JobStatusPanel } from "@/components/tools/job-status";
+import { useJobRunner } from "@/components/tools/use-job-runner";
+import { downloadFile } from "@/lib/api";
+
+/**
+ * Split a PDF by page ranges. Backend returns `output_file_ids: uuid[]`
+ * — one per group — so we render a per-file download list instead of
+ * the single "download" button JobStatusPanel ships by default.
+ */
+export function SplitClient() {
+  const [files, setFiles] = useState<File[]>([]);
+  const [ranges, setRanges] = useState("1-3,4-5");
+  const runner = useJobRunner();
+  const file = files[0];
+
+  async function onSubmit() {
+    if (!file) return;
+    await runner.run(
+      files,
+      (ids) => ({ input_file_id: ids[0], split_ranges: ranges }),
+      "split",
+    );
+  }
+
+  const outputs =
+    (runner.result?.output_file_ids as string[] | undefined) ?? [];
+
+  return (
+    <Card className="grid gap-8 p-8">
+      <FileDropzone files={files} onChange={setFiles} maxSizeMB={30} />
+
+      <label className="grid gap-2">
+        <span className="text-sm font-medium">Page ranges</span>
+        <input
+          type="text"
+          value={ranges}
+          onChange={(e) => setRanges(e.target.value)}
+          placeholder="1-3,4-5,7"
+          className="w-full rounded-lg border bg-card px-3 py-2 text-sm focus:border-primary focus:outline-none"
+        />
+        <span className="text-xs text-muted-foreground">
+          Each group becomes a separate PDF. Example: <code>1-3,5,7-9</code> → 3 files.
+        </span>
+      </label>
+
+      <div className="flex justify-end">
+        <Button
+          size="lg"
+          disabled={!file || !ranges.trim() || runner.phase === "uploading" || runner.phase === "running"}
+          onClick={onSubmit}
+        >
+          Split now →
+        </Button>
+      </div>
+
+      {runner.phase !== "done" && (
+        <JobStatusPanel
+          phase={runner.phase}
+          error={runner.error}
+          onReset={runner.reset}
+          hideDownload
+        />
+      )}
+
+      {runner.phase === "done" && outputs.length > 0 && (
+        <div className="rounded-xl border border-primary/30 bg-primary/5 p-4">
+          <p className="mb-3 text-sm font-medium">
+            {outputs.length} file{outputs.length === 1 ? "" : "s"} ready · expires in 5 minutes
+          </p>
+          <ul className="grid gap-2">
+            {outputs.map((id, i) => (
+              <li key={id} className="flex items-center justify-between rounded-lg border bg-card px-3 py-2 text-sm">
+                <span>Part {i + 1}</span>
+                <Button
+                  size="sm"
+                  variant="outline"
+                  onClick={() => downloadFile(id, `${file?.name ?? "split"}-part-${i + 1}.pdf`)}
+                >
+                  <Download className="mr-1.5 size-4" />
+                  Download
+                </Button>
+              </li>
+            ))}
+          </ul>
+        </div>
+      )}
+    </Card>
+  );
+}
