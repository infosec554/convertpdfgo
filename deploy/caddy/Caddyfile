{
	servers {
		protocols h1 h2
	}
}

# Caddyfile — convertpdfgo.com edge config
#
# Two upstreams share the apex domain:
#   * Backend (Go API, `api:8080`) — everything auth/api/file/oauth/ws
#     related plus Swagger + healthchecks.
#   * Frontend (Next.js, `web:3000`) — every other route, including the
#     marketing pages, tool UIs, and the /auth/callback SPA route that
#     finalises OAuth login.
#
# Path order matters: more specific `handle_path` / `handle` blocks
# come first, then the catch-all to web.

convertpdfgo.com {
	encode gzip zstd

	# Security headers — Google E-E-A-T trust signal + Lighthouse audit pass.
	header {
		Strict-Transport-Security  "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options     "nosniff"
		X-Frame-Options            "SAMEORIGIN"
		Referrer-Policy            "strict-origin-when-cross-origin"
		Permissions-Policy         "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
		X-XSS-Protection           "1; mode=block"
		Cross-Origin-Opener-Policy "same-origin"
		# CSP: balanced for Next.js (allow inline scripts/styles + gsi for Google sign-in)
		Content-Security-Policy    "default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com; frame-src 'self' blob: https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
		X-Robots-Tag               "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
		# Drop the legacy Server fingerprint to make pen-test scanners quieter
		-Server
	}

	# /auth/callback is the SPA's own page (reads tokens from the
	# query string and hops to the home screen). Has to be carved out
	# of the broader /auth/* matcher below — otherwise the catch-all
	# would send it to the backend, which has no such route, and the
	# user would land on a 404.
	@frontend_auth path /auth/callback
	handle @frontend_auth {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# Backend endpoints — see api/routes_*.go for the full list.
	# Matchers cover both the bare path (/api/contact) and any
	# subtree under it (/api/contact/123, /file/abc/download).
	@backend {
		path /api/* /auth/* /me /me/* /file /file/* /oauth/* /ws /ws/* /swagger /swagger/* /healthz /readyz /metrics /list
	}
	handle @backend {
		# 200 MB body cap matches the api's internal upload guard,
		# raise both sides together when bumping the tier limits.
		request_body {
			max_size 200MB
		}
		reverse_proxy api:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# Everything else → Next.js. The frontend itself handles its own
	# 404s and routing tree.
	handle {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}

# Admin console — its own hostname, not a path under the apex. Sharing
# the apex would put admin session cookies in the same scope as the
# public site; a separate host keeps them apart and lets the whole
# console sit behind one matcher.
#
# Needs a DNS A record for admin.convertpdfgo.com pointing here before
# Caddy can complete the ACME challenge for it.
admin.convertpdfgo.com {
	encode gzip zstd

	header {
		Strict-Transport-Security  "max-age=63072000; includeSubDomains"
		X-Content-Type-Options     "nosniff"
		X-Frame-Options            "DENY"
		Referrer-Policy            "strict-origin-when-cross-origin"
		# Never let an operations console into a search index.
		X-Robots-Tag               "noindex, nofollow"
		-Server
	}

	# The console talks to the Go API the same way the public site does,
	# so /api/* and the auth endpoints have to reach the backend here too.
	@backend {
		path /api/* /auth/* /me /me/* /file /file/* /healthz /readyz
	}
	handle @backend {
		request_body {
			max_size 200MB
		}
		reverse_proxy api:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		reverse_proxy admin:3001 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}

# www → apex redirect. OAuth providers register a single canonical
# redirect_uri; serving both www and apex without a redirect risks
# state-cookie mismatches when a user lands on the "wrong" hostname.
www.convertpdfgo.com {
	redir https://convertpdfgo.com{uri} permanent
}
