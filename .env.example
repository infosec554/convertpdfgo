# =====================================================================
# convertpdfgo — environment template
# Copy to .env and adjust. NEVER commit your real .env.
# Default values shown match config/config.go.
# =====================================================================

# --- Service ---
SERVICE_NAME=convertpdfgo
LOGGER_LEVEL=debug              # debug | info | warn | error
JWT_REQUIRED=false              # set "true" in prod → MustValidateSecret() runs

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432              # 5433 if using docker-compose port mapping
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=authservice

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379                 # 6380 if using docker-compose port mapping
REDIS_PASSWORD=1234
REDIS_TTL=5m

# --- JWT (>= 32 chars; generate with `openssl rand -hex 32`) ---
JWT_SECRET_KEY=default_secret_key

# --- Email (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER=noreply@convertpdfgo.com

# --- Gotenberg ---
GOTENBERG_URL=http://localhost:3000

# --- App URL (used as OAuth redirect base) ---
APP_URL=http://localhost:8080

# --- Frontend URL ---
# Where OAuth callback hands the token pair back to the SPA via a 302
# redirect to ${FRONTEND_URL}/auth/callback#access_token=...&refresh_token=...
# Leave empty for JSON-mode (curl / Swagger). Dev example below.
FRONTEND_URL=http://localhost:3000

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =====================================================================
# Cloud-export "Save to..." targets (optional)
#
# Each provider is independent — leave its credentials blank to hide
# the option in the UI. The browser-download path (/file/{id}/download)
# always works regardless of these settings.
#
# REDIRECT_URL defaults to ${APP_URL}/oauth/<provider>/callback when
# left blank, which is what you want unless you're terminating TLS or
# rewriting paths at the edge.
# =====================================================================

# --- Dropbox ---
# Register a "Scoped access" app at https://www.dropbox.com/developers/apps
# and grant the `files.content.write` permission.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URL=

# --- Google Drive ---
# Google Cloud Console → APIs & Services → enable "Google Drive API" →
# OAuth client (Web). Add `https://www.googleapis.com/auth/drive.file`
# to the consent screen. You can reuse GOOGLE_CLIENT_ID/SECRET above if
# you've added the Drive scope there, but a dedicated client is cleaner.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URL=

# --- OneDrive (Microsoft Graph) ---
# Azure portal → App registrations → API permissions → Microsoft Graph →
# Files.ReadWrite (delegated). Single-tenant or multi-tenant both work.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URL=

# --- LLM (Gemini) for /chat, /pptx-builder, /xlsx-builder ---
#
# QUOTA MATH. Each free-tier Google AI Studio key is capped at
# ~20 requests/day per model. Real-world ceiling per key is more like
# 15-20 for the production-grade chat models, regardless of the model
# name on the limit page. To support actual user traffic we rotate
# across a pool of keys — fill in GEMINI_API_KEYS with as many keys as
# you have. The provider round-robins on each request and, when a key
# returns 429 RESOURCE_EXHAUSTED, it's parked for the server-suggested
# retryDelay (or 60s if none) and the next key takes over.
#
# Either env var works:
#   GEMINI_API_KEYS  comma-separated pool, takes priority when set
#   GEMINI_API_KEY   single-key fallback, appended to the pool if not duplicated
#
# Generate fresh keys at https://aistudio.google.com/apikey — they are
# free and there's no hard cap on how many your account can hold.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=
